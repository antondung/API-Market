# Sao chép file này thành .env.docker rồi đổi JWT_SECRET trước khi chạy docker compose.
#
#   Copy-Item .env.docker.example .env.docker
#
# Sinh JWT_SECRET ngẫu nhiên (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#
# Không commit .env.docker — file đã được .gitignore bỏ qua.

# =========================================
# PostgreSQL
# =========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=api_market_dev
POSTGRES_PORT=5432

# =========================================
# Redis
# =========================================
REDIS_PORT=6379

# =========================================
# Backend
# =========================================
BACKEND_PORT=3000
NODE_ENV=development

# BẮT BUỘC đổi giá trị này. Tối thiểu 32 byte.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Origin chính xác của frontend, phân cách bằng dấu phẩy. Không dùng wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================================
# Frontend
# =========================================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
SANDBOX_WEBHOOK_SECRET=
# Để trống ở development: backend tự suy ra từ JWT_SECRET. Production bắt buộc đặt riêng, tối thiểu 32 byte.
UPSTREAM_SIGNING_KEY=
# Để trống để mỗi API có secret HMAC riêng. Đặt cùng giá trị với upstream demo khi muốn ký chung, tối thiểu 32 byte.
UPSTREAM_HMAC_SECRET=
# Worker gọi run_subscription_maintenance. Mặc định 5 phút.
MAINTENANCE_INTERVAL_MS=300000
