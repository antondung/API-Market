# Run npm run setup to create local .env with random secrets.
AUTH_STORE=sqlite
DATABASE_PATH=data/api-market.sqlite
PORT=3000
HOST=127.0.0.1
# Exact frontend origins, separated by commas. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Local sample accounts only; never run db:seed in production.
SEED_ADMIN_PASSWORD=replace-with-random-password
SEED_CONSUMER_PASSWORD=replace-with-random-password
SEED_PROVIDER_PASSWORD=replace-with-random-password
