# Run npm run setup to create local .env with random secrets.
AUTH_STORE=postgres
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/api_market_dev
PORT=3000
HOST=127.0.0.1
# Exact frontend origins, separated by commas. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional. Comma-separated DNS resolver IP or IP:port list used to check provider domain TXT
# records. Empty uses the system resolver. Example: DNS_SERVERS=8.8.8.8,1.1.1.1
# Run db:seed explicitly for Danh's development demo accounts. Never use them in production.
