# Mẫu cho /opt/api-market/.env.production. Đổi mọi placeholder trên máy chủ, không commit file thật.
# Secret GitHub Actions của .github/workflows/cd-production.yml nằm ngoài file này:
# PROD_HOST, PROD_USER, PROD_SSH_KEY. Thiếu một secret thì workflow bỏ qua deploy.
NODE_ENV=production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-production-db-password
POSTGRES_DB=api_market_prod
JWT_SECRET=replace-with-independent-random-secret
SANDBOX_WEBHOOK_SECRET=replace-with-independent-random-secret
GATEWAY_UPSTREAM_SECRET=replace-with-independent-random-secret
CORS_ORIGINS=https://market.example.com
# Must match repository variable PROD_API_BASE_URL used when building the frontend image.
VITE_API_BASE_URL=https://api.example.com
BACKEND_PORT=3000
FRONTEND_PORT=5173
WEATHER_PUBLIC_ORIGIN=https://weather.example.com
CURRENCY_PUBLIC_ORIGIN=https://currency.example.com
CATALOG_PUBLIC_ORIGIN=https://catalog.example.com
# Lowercase GitHub owner/repository. The deploy workflow also exports IMAGE_TAG as the commit SHA.
GHCR_OWNER=antondung/api-market
IMAGE_TAG=production
