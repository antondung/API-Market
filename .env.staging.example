# Mẫu cho /opt/api-market/.env.staging. Đổi mọi placeholder trên máy chủ, không commit file thật.
# Secret GitHub Actions của .github/workflows/cd-staging.yml nằm ngoài file này:
# STAGING_HOST, STAGING_USER, STAGING_SSH_KEY. Thiếu một secret thì workflow bỏ qua deploy.
NODE_ENV=production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=api_market_staging
JWT_SECRET=replace-with-independent-random-secret
SANDBOX_WEBHOOK_SECRET=replace-with-independent-random-secret
GATEWAY_UPSTREAM_SECRET=replace-with-independent-random-secret
CORS_ORIGINS=https://market-staging.example.com
# Must match repository variable STAGING_API_BASE_URL used when building the frontend image.
VITE_API_BASE_URL=https://api-staging.example.com
BACKEND_PORT=3000
FRONTEND_PORT=5173
WEATHER_PUBLIC_ORIGIN=https://weather-staging.example.com
CURRENCY_PUBLIC_ORIGIN=https://currency-staging.example.com
CATALOG_PUBLIC_ORIGIN=https://catalog-staging.example.com
# Lowercase GitHub owner/repository. The deploy workflow also exports IMAGE_TAG as the commit SHA.
GHCR_OWNER=antondung/api-market
IMAGE_TAG=staging
