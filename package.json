{
  "name": "api-market-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx backend/src/server.ts",
    "provider:import": "node --import tsx backend/src/provider-import-cli.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "setup": "node scripts/setup-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx backend/src/database-cli.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx backend/src/database-cli.ts --seed",
    "demo:apis": "node mock-services/server.mjs all",
    "demo:weather": "node mock-services/server.mjs weather",
    "demo:currency": "node mock-services/server.mjs currency",
    "demo:catalog": "node mock-services/server.mjs catalog"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
