{
  "name": "qa-scripts-sprint1",
  "version": "1.0.0",
  "description": "Script kiểm thử tự động Sprint 1 — API Market",
  "type": "module",
  "scripts": {
    "test": "node run-all.js",
    "qa:sprint3:smoke": "playwright test --grep \"@smoke\" --config=sprint3-frontend/playwright.config.ts",
    "qa:sprint3:functional": "playwright test sprint3-frontend/tests/01-marketplace.spec.ts sprint3-frontend/tests/02-api-detail.spec.ts sprint3-frontend/tests/03-api-playground.spec.ts sprint3-frontend/tests/04-try-sandbox.spec.ts sprint3-frontend/tests/05-pricing.spec.ts sprint3-frontend/tests/06-checkout.spec.ts sprint3-frontend/tests/07-compare-apis.spec.ts sprint3-frontend/tests/08-navigation-layout.spec.ts --config=sprint3-frontend/playwright.config.ts",
    "qa:sprint3:visual": "playwright test sprint3-frontend/tests/09-responsive-viewports.spec.ts --config=sprint3-frontend/playwright.config.ts",
    "qa:sprint3:a11y": "playwright test sprint3-frontend/tests/11-accessibility-wcag.spec.ts --config=sprint3-frontend/playwright.config.ts",
    "qa:sprint3:full": "playwright test sprint3-frontend/tests/ --config=sprint3-frontend/playwright.config.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1"
  }
}
